
<mujoco model="oven-mini-01_demo">
  <compiler angle="radian" meshdir="meshes"/>
  <option timestep="0.002" gravity="0 0 -9.81" cone="elliptic"/>
  <visual><global offwidth="1280" offheight="720"/></visual>
  <default>
    <geom solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <default class="vis"><geom contype="0" conaffinity="0" group="2" rgba="0.78 0.63 0.44 1"/></default>
  </default>
  <asset>
['    <mesh name="base" file="base.stl"/>', '    <mesh name="door" file="door.stl"/>']

    <texture name="grid" type="2d" builtin="checker" rgb1="0.92 0.92 0.9" rgb2="0.8 0.8 0.78" width="300" height="300"/>
    <material name="floor_mat" texture="grid" texuniform="true"/>
  </asset>
  <worldbody>
    <light pos="1.2 -1.5 1.8" dir="-0.5 0.6 -0.6" diffuse="0.9 0.9 0.85" castshadow="false"/>
    <light pos="-1.0 -1.2 1.4" dir="0.4 0.5 -0.6" diffuse="0.5 0.5 0.55" castshadow="false"/>
    <geom name="floor" type="plane" size="2.5 2.5 0.05" material="floor_mat"/>
    <body name="base" pos="0.000000 0.000000 0.195301">
      <geom class="vis" type="mesh" mesh="base" mass="85.2890"/>
      <body name="door" pos="0.001510 -0.117745 -0.144612">
        <joint name="door_joint" type="hinge" axis="-0.999999 -0.001129 -0.000180" range="-1.570796 0.000000" damping="0.5" frictionloss="0.05" armature="0.01"/>
        <geom class="vis" type="mesh" mesh="door" mass="7.3190"/>
      </body>
    </body>  </worldbody>
  <actuator>
    <position name="door_joint_act" joint="door_joint" kp="40.0"/>
  </actuator>
</mujoco>
