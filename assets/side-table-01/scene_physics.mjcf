
<mujoco model="side-table-01_physics">
  <compiler angle="radian" meshdir="."/>
  <option timestep="0.001" gravity="0 0 -9.81" cone="elliptic"/>
  <visual><global offwidth="1280" offheight="720"/></visual>
  <default>
    <geom solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <default class="vis"><geom contype="0" conaffinity="0" group="2" rgba="0.78 0.63 0.44 1"/></default>
    <default class="col">
      <geom group="3" rgba="0.6 0.85 0.6 0.35"/>
    </default>
  </default>
  <asset>
['    <mesh name="body_h0" file="collision/body_hull01.stl"/>', '    <mesh name="body_h1" file="collision/body_hull03.stl"/>', '    <mesh name="body_h2" file="collision/body_hull04.stl"/>', '    <mesh name="body_h3" file="collision/body_hull06.stl"/>', '    <mesh name="drawer_h0" file="collision/drawer_hull00.stl"/>']
    <mesh name="body_vismesh" file="meshes/body.stl"/>
    <mesh name="drawer_vismesh" file="meshes/drawer.stl"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.92 0.92 0.9" rgb2="0.8 0.8 0.78" width="300" height="300"/>
    <material name="floor_mat" texture="grid" texuniform="true"/>
  </asset>
  <worldbody>
    <light pos="1.2 -1.5 1.8" dir="-0.5 0.6 -0.6" diffuse="0.9 0.9 0.85" castshadow="false"/>
    <light pos="-1.0 -1.2 1.4" dir="0.4 0.5 -0.6" diffuse="0.5 0.5 0.55" castshadow="false"/>
    <geom name="floor" type="plane" size="2.5 2.5 0.05" material="floor_mat"/>
    <body name="body" pos="0.000000 0.000000 0.275000">
      <geom class="col" type="mesh" mesh="body_h0" mass="80.8830"/>
      <geom class="col" type="mesh" mesh="body_h1" mass="0.0000"/>
      <geom class="col" type="mesh" mesh="body_h2" mass="0.0000"/>
      <geom class="col" type="mesh" mesh="body_h3" mass="0.0000"/>
      <geom class="vis" type="mesh" mesh="body_vismesh" mass="0"/>
      <body name="drawer" pos="0.002404 -0.051230 0.173107">
        <joint name="drawer_joint" type="slide" axis="0.000000 -1.000000 0.000000" range="0.000000 0.332522" damping="2.0" frictionloss="1.0" armature="0.01"/>
        <geom class="col" type="mesh" mesh="drawer_h0" mass="1.4070"/>
        <geom class="vis" type="mesh" mesh="drawer_vismesh" mass="0"/>
      </body>
    </body>  </worldbody>
  <actuator>
    <motor name="drawer_joint_motor" joint="drawer_joint" gear="1" ctrlrange="-60.0 60.0"/>
  </actuator>
</mujoco>
